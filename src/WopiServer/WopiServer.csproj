<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>wopiserver</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Buffers" />
    <Using Include="System.Buffers.Text" />
    <Using Include="System.Globalization" />
    <Using Include="System.IO.Compression" />
    <Using Include="System.Net" />
    <Using Include="System.Net.Http.Headers" />
    <Using Include="System.Security.Cryptography" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Text.Json.Nodes" />
    <Using Include="System.Text.Json.Serialization" />
    <Using Include="System.Text.RegularExpressions" />
    <Using Include="Microsoft.Extensions.Primitives" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="prometheus-net.AspNetCore" />
    <None Update="wopiserver.defaults.conf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
