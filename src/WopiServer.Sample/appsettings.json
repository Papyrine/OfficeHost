{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://0.0.0.0:5000",
  "Sample": {
    // the folder of the files, relative to the project
    "Files": "files",
    // the URL the browser opens the application at
    "AppUrl": "http://localhost:5000"
  },
  "Wopi": {
    // a development key: use a secret of your own outside of this sample
    "SigningKey": "the signing key of the sample, do not use it elsewhere",
    // the URL the WOPI client reaches the application at: from a container, the host is host.docker.internal
    "BaseUrl": "http://host.docker.internal:5000",
    "DiscoveryUrls": [
      "http://localhost:9980/hosting/discovery"
    ]
  }
}
