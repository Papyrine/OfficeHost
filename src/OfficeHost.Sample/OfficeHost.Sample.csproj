<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
  A web application hosting the WOPI endpoints: lists the files of a folder, and opens them in a WOPI client. See the
  Sample section of readme.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO.Compression" />
    <Using Include="System.Net" />
    <Using Include="OfficeHost" />
    <Using Include="Morph" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\OfficeHost\OfficeHost.csproj" />
    <ProjectReference Include="..\OfficeHost.Shadow\OfficeHost.Shadow.csproj" />
    <!-- Morph, a WOPI client the sample serves itself: its endpoints, and its editor as static assets -->
    <PackageReference Include="Morph.Wopi" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <ProjectReference Include="..\OfficeHost.Sample.Morph\OfficeHost.Sample.Morph.csproj" />
  </ItemGroup>
</Project>
