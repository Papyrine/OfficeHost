<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
  A shadow of SharePoint on SQL Server (docs/shadow.md, "The shadow sample"): receives desktop Office's traffic from the
  OfficeHost.SharePoint module, replays it to OfficeHost, whose files and state are in a database of its own, and logs
  how the answers compare. Runs as a console application, or as a Windows service.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="OfficeHost" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <ProjectReference Include="..\OfficeHost\OfficeHost.csproj" />
    <ProjectReference Include="..\OfficeHost.Shadow\OfficeHost.Shadow.csproj" />
    <ProjectReference Include="..\OfficeHost.SqlServer\OfficeHost.SqlServer.csproj" />
    <ProjectReference Include="..\OfficeHost.SqlServer.Install\OfficeHost.SqlServer.Install.csproj" />
    <None Update="Send-Recording.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
