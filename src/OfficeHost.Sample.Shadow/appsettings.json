{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    // the Windows event log: the differences, failures and summaries of the shadow (docs/shadow.md, "Outcomes")
    "EventLog": {
      "SourceName": "OfficeHost Shadow",
      "LogLevel": {
        "Default": "Warning",
        "ShadowProcessor": "Information"
      }
    }
  },
  "Urls": "http://localhost:5002",
  "ConnectionStrings": {
    // the shadow's own database, created when missing: never SharePoint's, nor the application's in production
    "OfficeHost": "Server=(localdb)\\MSSQLLocalDB;Database=OfficeHostShadow;Integrated Security=true;TrustServerCertificate=true"
  },
  "Shadow": {
    "Schema": "dbo",
    // creates the database when missing, and the tables of OfficeHost.SqlServer
    "InstallDatabase": true
  },
  "OfficeHost": {
    // a development key: use a secret of your own outside of this sample
    "SigningKey": "the signing key of the shadow sample, do not use it elsewhere"
  },
  "OfficeHostShadow": {
    // the key the module sends (Install-OfficeHostShadow.ps1 -ApiKey): none refuses every batch
    "ApiKey": ""
  }
}
